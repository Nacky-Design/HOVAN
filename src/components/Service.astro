---
import Arrow from './Arrow.astro';
import Panel from './Panel.astro';

const topics = [
  { id: 'size', title: 'Подобрать размер', items: ['Посадка', 'Размерный ряд'] },
  { id: 'fitting', title: 'Записаться на примерку', items: ['Порядок примерки', 'Выбор изделия'] },
  { id: 'question', title: 'Задать вопрос о размере', items: ['Нестандартный размер', 'Посадка изделия'] },
];
---
<section id="service" class="service page-gutter" data-section aria-labelledby="service-title">
  <div>
    <p class="eyebrow">Сервис HOVAN</p>
    <h2 id="service-title" class="chapter-title">Вещь должна подходить вам, а не наоборот.</h2>
  </div>
  <div class="actions">
    {topics.map(topic => (
      <button class="text-action" type="button" aria-haspopup="dialog" data-dialog-open={'service-' + topic.id}>{topic.title} <Arrow /></button>
    ))}
    <details id="care">
      <summary>Перешив и уход</summary>
      <p class="muted">Условия ухода и индивидуальной работы уточняются.</p>
    </details>
  </div>
</section>
{topics.map(topic => (
  <Panel id={'service-' + topic.id} title={topic.title}>
    <p class="muted">Демонстрационная форма. Данные не отправляются.</p>
    <form method="dialog" data-demo-form>
      <label>
        Тема
        <select required>
          <option value="">Выберите тему</option>
          {topic.items.map(item => <option>{item}</option>)}
        </select>
      </label>
      <button type="submit" class="pill">Проверить форму</button>
      <p data-form-result role="status"> </p>
    </form>
  </Panel>
))}

<style>
  .service { display: grid; gap: 30px; padding-block: var(--chapter-space); }
  .chapter-title { max-width: 13ch; }
  .actions > .text-action { display: flex; justify-content: space-between; min-height: 68px; width: 100%; border-top: 1px solid var(--rule); text-align: left; }
  details { border-block: 1px solid var(--rule); }
  summary { display: list-item; padding-block: 20px; cursor: pointer; }
  details p { margin-bottom: 20px; }
  form { display: grid; gap: 20px; margin-top: 24px; }
  label { display: grid; gap: 10px; }
  select { width: 100%; min-height: 48px; padding: 10px; border: 1px solid #8b857b; background: var(--header); color: var(--ink); font: inherit; }
  form button { justify-self: start; }
  [data-form-result] { min-height: 1.5em; }
  @media (min-width: 960px) { .service { grid-template-columns: minmax(0, 49fr) minmax(0, 51fr); gap: 5vw; } .actions { align-self: center; } }
</style>
