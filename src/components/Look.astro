---
import Arrow from './Arrow.astro';
import EditorialPhoto from './EditorialPhoto.astro';

interface Props {
  number: '01' | '02';
  title: string[];
  description: string;
  photo: string;
  alt: string;
  detailPhoto: string;
  detailAlt: string;
  details: string[];
  candidate?: { id: string; label: string };
}
const { number, title, description, photo, alt, detailPhoto, detailAlt, details, candidate } = Astro.props;
const id = 'look-' + number;
---
<article class:list={['look', { reversed: number === '02' }]} aria-labelledby={id + '-heading'}>
  <div class="look-media">
    <EditorialPhoto photo={photo} alt={alt} />
    <button type="button" class="photo-action pill" data-dialog-open={id} aria-haspopup="dialog" aria-label={'В образе — образ ' + number}>
      В образе <Arrow />
    </button>
  </div>
  <div class="look-copy">
    <div>
      <p class="eyebrow">Образ / {number}</p>
      <h3 id={id + '-heading'}>{title.map(line => <span>{line}{' '}</span>)}</h3>
      <p class="description">{description}</p>
    </div>
    <div class="look-details">
      <p class="eyebrow">Детали образа</p>
      <ul>
        {details.map(detail => (
          <li>
            <button type="button" class="detail-row" data-dialog-open={id} data-look-open-detail={detail} aria-haspopup="dialog">
              {detail} <Arrow />
            </button>
          </li>
        ))}
      </ul>
    </div>
    <div class="look-action">
      <button type="button" data-dialog-open={id} aria-haspopup="dialog" aria-label={'В образе — образ ' + number}>
        В образе <Arrow />
      </button>
    </div>
  </div>
  <dialog id={id} data-panel aria-labelledby={id + '-title'}>
    <div class="panel">
      <header class="panel-header">
        <h2 id={id + '-title'}>Образ {number}</h2>
        <button type="button" class="close" data-dialog-close aria-label="Закрыть панель" autofocus>×</button>
      </header>
      <div data-look-list>
        <p class="status">Состав образа уточняется.</p>
        <ul aria-label="Детали на фотографии">
          {details.map(detail => <li>{detail}</li>)}
        </ul>
        {candidate && <button type="button" class="text-action candidate" data-dialog-open={'product-' + candidate.id} aria-haspopup="dialog">{candidate.label} <Arrow /><span class="visually-hidden">, предварительная привязка</span></button>}
        <button type="button" class="pill" data-look-detail>Быстрый просмотр <Arrow /></button>
      </div>
      <div class="quick-view" data-look-view hidden>
        <h3 tabindex="-1">Быстрый просмотр</h3>
        <p class="muted" data-look-context hidden></p>
        <EditorialPhoto photo={detailPhoto} alt={detailAlt} />
        <button type="button" class="back" data-look-back><span aria-hidden="true">←</span> К образу</button>
      </div>
    </div>
  </dialog>
</article>

<style>
  .look { display: grid; background: var(--look); }
  .look-copy { display: flex; flex-direction: column; justify-content: space-between; gap: clamp(28px, 4vw, 58px); padding: clamp(32px, 7vw, 76px) var(--gutter); min-width: 0; }
  .look-copy h3 { margin-block: .42em .33em; font-size: clamp(2rem, 9.5vw, 3.15rem); line-height: .99; letter-spacing: -.058em; font-weight: 430; }
  .look-copy h3 span { display: block; }
  .reversed .look-copy h3 span { display: inline; }
  .look-media { position: relative; display: grid; min-width: 0; }
  .photo-action.pill { position: absolute; left: var(--gutter); bottom: 20px; width: auto; background: var(--header); color: var(--ink); border-color: var(--header); }
  .look-details ul { margin: 12px 0 0; }
  .look-details li { padding: 0; }
  .detail-row { min-height: 48px; display: flex; align-items: center; justify-content: space-between; gap: 10px; width: 100%; padding: 12px 0; border: 0; background: transparent; text-align: left; }
  .detail-row:hover { color: var(--color-accent-hishat); }
  .look-action { display: none; }
  .description, .status { color: var(--muted); max-width: 34ch; }
  .look-action button { width: 100%; padding: 14px 0; min-height: 49px; border: 0; border-block: 1px solid var(--rule); background: transparent; display: flex; justify-content: space-between; align-items: center; gap: 12px; text-align: left; }
  .look-action button:hover, .back:hover { color: var(--color-accent-hishat); }
  dialog { width: min(100%, 560px); max-width: 100%; max-height: 88dvh; margin: auto auto 0; padding: 0; background: var(--header); color: var(--ink); border: 0; border-radius: 18px 18px 0 0; overscroll-behavior: contain; }
  dialog::backdrop { background: #1c1c1a66; }
  .panel { padding: clamp(20px, 5vw, 44px); }
  .panel-header { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 12px; }
  .panel-header h2 { font-size: clamp(1.75rem, 5vw, 2.5rem); line-height: 1.03; letter-spacing: -.05em; font-weight: 480; }
  .close, .back { background: transparent; border: 0; min-height: 44px; padding: 0 8px; }
  .close { min-width: 44px; font-size: 1.65rem; }
  .back { padding-inline: 0; }
  ul { list-style: none; padding: 0; margin: 22px 0; border-top: 1px solid var(--rule); }
  li { padding: 13px 0; border-bottom: 1px solid var(--rule); }
  .pill { gap: 12px; width: 100%; }
  .candidate { margin-bottom: 10px; }
  .quick-view { display: grid; gap: 16px; justify-items: start; }
  .quick-view :global(figure) { width: 100%; aspect-ratio: 4 / 3; }
  .quick-view h3 { font-weight: 500; }
  @media (min-width: 960px) {
    .look { grid-template-columns: minmax(0, 67fr) minmax(0, 33fr); min-height: clamp(650px, 69.45vw, 1120px); }
    .reversed { grid-template-columns: minmax(0, 33fr) minmax(0, 67fr); }
    .reversed .look-copy { grid-column: 1; grid-row: 1; }
    .reversed .look-media { grid-column: 2; grid-row: 1; }
    .look-copy { padding: clamp(52px, 6vw, 100px) clamp(28px, 3.2vw, 65px); }
    .look-action { display: block; }
    .photo-action.pill { display: none; }
    .look-copy h3 { font-size: clamp(2.25rem, 4.45vw, 6rem); }
    .reversed .look-copy h3 span { display: block; }
    dialog { height: 100dvh; max-height: 100dvh; margin: 0 0 0 auto; border-radius: 0; }
  }
</style>
