---
interface Props {
  id: string;
  title: string;
  mode?: 'drawer' | 'story';
}
const { id, title, mode = 'drawer' } = Astro.props;
---
<dialog id={id} class:list={['panel-shell', mode]} data-panel aria-labelledby={id + '-title'}>
  <div class="inner">
    <header class="panel-heading">
      <h2 id={id + '-title'}>{title}</h2>
      <button type="button" data-dialog-close aria-label="Закрыть" autofocus>×</button>
    </header>
    <slot />
  </div>
</dialog>

<style>
  .panel-shell { width: min(100%, 580px); max-width: 100%; max-height: 88dvh; margin: auto auto 0; padding: 0; color: var(--ink); background: var(--header); border: 0; border-radius: 18px 18px 0 0; overscroll-behavior: contain; }
  .panel-shell::backdrop { background: #1c1c1a66; }
  .story { width: 100%; height: 100dvh; max-height: 100dvh; border-radius: 0; }
  .inner { padding: clamp(20px, 5vw, 44px); }
  .story .inner { max-width: 880px; margin: auto; }
  .panel-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 18px; margin-bottom: 24px; }
  h2 { font-size: clamp(1.75rem, 5vw, 2.65rem); line-height: 1.05; letter-spacing: -.055em; font-weight: 480; overflow-wrap: anywhere; }
  button { padding: 0; min-width: 44px; min-height: 44px; border: 0; background: transparent; font-size: 1.75rem; }
  @media (min-width: 960px) {
    .drawer { height: 100dvh; max-height: 100dvh; margin: 0 0 0 auto; border-radius: 0; }
  }
</style>
